BOT_TOKEN=

# postgres://user:pass@host:5432/dbname
DATABASE_URL=postgres://bot:bot@postgres:5432/anti_sedentary

TIMEZONE=Europe/Amsterdam
LOG_LEVEL=INFO

# Comma-separated Telegram user_ids that get /admin command
ADMIN_USER_IDS=

# --- LLM provider --------------------------------------------------------------------
# Any OpenAI-compatible endpoint. Examples (set both URL and MODEL):
#   Groq        https://api.groq.com/openai/v1            llama-3.3-70b-versatile
#   OpenAI      https://api.openai.com/v1                  gpt-4o-mini
#   Together    https://api.together.xyz/v1                meta-llama/Llama-3.3-70B-Instruct-Turbo
#   OpenRouter  https://openrouter.ai/api/v1               anthropic/claude-haiku-4.5
#   Ollama      http://localhost:11434/v1                  llama3.2
LLM_ENABLED=true
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=

# Legacy fallback used only if LLM_API_KEY is empty
GROQ_API_KEY=
